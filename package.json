{
  "name": "orbit",
  "version": "3.0.0",
  "private": true,
  "description": "Orbit — one premium client for Reddit, X and YouTube (Chrome MV3 extension)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mjs",
    "test": "npm run build && node tests/e2e.mjs && node tests/e2e-x.mjs && node tests/e2e-youtube.mjs",
    "test:reddit": "npm run build && node tests/e2e.mjs",
    "test:x": "npm run build && node tests/e2e-x.mjs",
    "test:youtube": "npm run build && node tests/e2e-youtube.mjs",
    "package": "npm run build && node scripts/zip.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4"
  }
}
